{
  "name": "xxrenq-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:preview": "tsc -b && vite build --config vite.config.preview.ts",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --var ENVIRONMENT:development",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "db:local": "wrangler d1 migrations apply xxrenq-access --local --config worker/wrangler.toml",
    "db:remote": "wrangler d1 migrations apply xxrenq-access --remote --config worker/wrangler.toml"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.147.0"
  }
}
